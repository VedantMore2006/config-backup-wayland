%%Title: (random)
%%CreationDate: (2025-07-20T12:54:07+00:00)
%%BoundingBox: -0 -0 951 1042
%%HiResBoundingBox: 0 0 951 1042
%%DocumentData: Clean7Bit
%%LanguageLevel: 1
%%Orientation: Portrait
%%PageOrder: Ascend
